import fs from 'node:fs'
import path from 'node:path'
import { parse } from 'yaml'
import { readLayout, readYaml, specFiles, type Layout } from './layout.mts'

export type Item = { text: string; link?: string; items?: Item[]; collapsed?: boolean }

export type Post = {
  title: string
  link: string
  date: string
  author?: string
  tags: string[]
  description?: string
}

export type Blog = { dir: string; rel: string; layout: Layout; posts: Post[] }

export const GENERATED = '<!-- generated by docstar -->'
const METHODS = ['get', 'put', 'post', 'delete', 'options', 'head', 'patch', 'trace']

/** Results of the last `generateAll` run, read by the sidebar and RSS builders. */
export const apiItems = new Map<string, Item[]>()
export const blogs = new Map<string, Blog>()

const titleCase = (s: string) => s.replace(/[-_]+/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase())
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'untitled'
const toLink = (rel: string) => '/' + rel.replace(/\\/g, '/')

/** Escapes text for use in Markdown/Vue templates (table cells, headings). */
const esc = (s: unknown) =>
  String(s ?? '')
    .replace(/\r?\n/g, ' ')
    .replace(/\|/g, '\\|')
    .replace(/</g, '&lt;')
    .replace(/\{\{/g, '&#123;&#123;')

/** Escapes free-form descriptions, which may contain Markdown, but never raw HTML or Vue interpolation. */
const prose = (s: unknown) => String(s ?? '').replace(/</g, '&lt;').replace(/\{\{/g, '&#123;&#123;')

// ---------------------------------------------------------------- walking

function walk(dir: string, fn: (dir: string, layout: Layout) => void) {
  fn(dir, readLayout(dir))
  for (const e of fs.readdirSync(dir, { withFileTypes: true })) {
    if (!e.isDirectory() || e.name.startsWith('.') || e.name === 'public' || e.name === 'node_modules') continue
    if (e.name === '_api') continue
    walk(path.join(dir, e.name), fn)
  }
}

/** Collects `path -> content` and writes only the files that changed. Returns true if files were added or removed. */
function sync(out: Map<string, string>, ownedDirs: string[]): boolean {
  let structural = false
  for (const [file, content] of out) {
    if (fs.existsSync(file)) {
      if (fs.readFileSync(file, 'utf8') === content) continue
    } else {
      structural = true
    }
    fs.mkdirSync(path.dirname(file), { recursive: true })
    fs.writeFileSync(file, content)
  }
  for (const dir of ownedDirs) {
    if (!fs.existsSync(dir)) continue
    for (const file of listFiles(dir)) {
      if (out.has(file)) continue
      if (!file.endsWith('.md') || !fs.readFileSync(file, 'utf8').includes(GENERATED)) continue
      fs.rmSync(file)
      structural = true
    }
  }
  return structural
}

function listFiles(dir: string): string[] {
  return fs.readdirSync(dir, { withFileTypes: true }).flatMap((e) => {
    const full = path.join(dir, e.name)
    return e.isDirectory() ? listFiles(full) : [full]
  })
}

/** Generates API pages and blog indexes for every folder with a layout. Call before reading the sidebar. */
export function generateAll(root: string): boolean {
  apiItems.clear()
  blogs.clear()
  const out = new Map<string, string>()
  const owned: string[] = []

  walk(root, (dir, layout) => {
    const rel = path.relative(root, dir)
    if (layout.type === 'api') {
      const specs = specFiles(dir, layout.spec)
      if (!specs.length) return
      const { files, items } = buildApi(dir, rel, specs)
      files.forEach((v, k) => out.set(k, v))
      apiItems.set(dir, items)
      owned.push(path.join(dir, '_api'))
    } else if (layout.type === 'blog') {
      const blog = readBlog(dir, rel, layout)
      blogs.set(dir, blog)
      buildBlogPages(blog).forEach((v, k) => out.set(k, v))
      owned.push(path.join(dir, 'tags'))
    }
  })

  // Hand-written index pages win over generated ones.
  for (const file of [...out.keys()]) {
    if (path.basename(file) === 'index.md' && fs.existsSync(file)) {
      if (!fs.readFileSync(file, 'utf8').includes(GENERATED)) out.delete(file)
    }
  }
  return sync(out, owned)
}

// ---------------------------------------------------------------- blog

function frontmatter(file: string): Record<string, any> {
  const m = fs.readFileSync(file, 'utf8').match(/^---\r?\n([\s\S]*?)\r?\n---/)
  if (!m) return {}
  try {
    return parse(m[1]) ?? {}
  } catch {
    return {}
  }
}

function readBlog(dir: string, rel: string, layout: Layout): Blog {
  const posts: Post[] = fs
    .readdirSync(dir, { withFileTypes: true })
    .filter((e) => e.isFile() && e.name.endsWith('.md') && e.name !== 'index.md')
    .map((e) => {
      const file = path.join(dir, e.name)
      const fm = frontmatter(file)
      const h1 = fs.readFileSync(file, 'utf8').match(/^#\s+(.+)$/m)
      const base = path.basename(e.name, '.md')
      return {
        title: String(fm.title ?? h1?.[1].trim() ?? titleCase(base)),
        link: toLink(path.join(rel, base)),
        date: fm.date ? new Date(fm.date).toISOString().slice(0, 10) : '',
        author: fm.author ? String(fm.author) : undefined,
        tags: Array.isArray(fm.tags) ? fm.tags.map(String) : fm.tags ? [String(fm.tags)] : [],
        description: fm.description ? String(fm.description) : undefined,
      }
    })
    .sort((a, b) => b.date.localeCompare(a.date) || a.title.localeCompare(b.title))
  return { dir, rel, layout, posts }
}

const tagLine = (rel: string, tags: string[]) =>
  tags.map((t) => `[${esc(t)}](${toLink(path.join(rel, 'tags', slug(t)))})`).join(' · ')

function postList(blog: Blog, posts: Post[]): string {
  return posts
    .map((p) => {
      const meta = [p.date, p.author].filter(Boolean).join(' · ')
      return [
        `## [${esc(p.title)}](${p.link})`,
        meta && `<small>${esc(meta)}</small>`,
        p.description && prose(p.description),
        p.tags.length && tagLine(blog.rel, p.tags),
      ]
        .filter(Boolean)
        .join('\n\n')
    })
    .join('\n\n')
}

function buildBlogPages(blog: Blog): Map<string, string> {
  const out = new Map<string, string>()
  const title = blog.layout.title ?? titleCase(path.basename(blog.dir))
  const tags = new Map<string, Post[]>()
  for (const p of blog.posts) for (const t of p.tags) tags.set(t, [...(tags.get(t) ?? []), p])

  out.set(
    path.join(blog.dir, 'index.md'),
    `---\ntitle: ${JSON.stringify(title)}\n---\n${GENERATED}\n\n# ${esc(title)}\n\n` +
      (blog.posts.length ? postList(blog, blog.posts) : '_No posts yet._') + '\n',
  )
  const tagIndex = [...tags.keys()].sort().map((t) => `- [${esc(t)}](${toLink(path.join(blog.rel, 'tags', slug(t)))}) (${tags.get(t)!.length})`)
  out.set(
    path.join(blog.dir, 'tags', 'index.md'),
    `---\ntitle: Tags\n---\n${GENERATED}\n\n# Tags\n\n${tagIndex.join('\n') || '_No tags yet._'}\n`,
  )
  for (const [tag, posts] of tags) {
    out.set(
      path.join(blog.dir, 'tags', `${slug(tag)}.md`),
      `---\ntitle: ${JSON.stringify(`Tag: ${tag}`)}\n---\n${GENERATED}\n\n# Tag: ${esc(tag)}\n\n${postList(blog, posts)}\n`,
    )
  }
  return out
}

const xml = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')

/** RSS 2.0 feed for a blog. `site` (e.g. https://example.com) makes links absolute; `base` is the deploy base path. */
export function buildRss(blog: Blog, site: string, base: string, siteTitle: string): string {
  const abs = (link: string) => site.replace(/\/$/, '') + base.replace(/\/$/, '') + link
  const title = blog.layout.title ?? titleCase(path.basename(blog.dir))
  const items = blog.posts
    .map(
      (p) =>
        `    <item>\n      <title>${xml(p.title)}</title>\n      <link>${xml(abs(p.link))}</link>\n      <guid>${xml(abs(p.link))}</guid>\n` +
        (p.date ? `      <pubDate>${new Date(p.date).toUTCString()}</pubDate>\n` : '') +
        (p.description ? `      <description>${xml(p.description)}</description>\n` : '') +
        p.tags.map((t) => `      <category>${xml(t)}</category>\n`).join('') +
        `    </item>`,
    )
    .join('\n')
  return `<?xml version="1.0" encoding="UTF-8"?>\n<rss version="2.0">\n  <channel>\n    <title>${xml(`${title} – ${siteTitle}`)}</title>\n    <link>${xml(abs(toLink(blog.rel) + '/'))}</link>\n    <description>${xml(title)}</description>\n${items}\n  </channel>\n</rss>\n`
}

// ---------------------------------------------------------------- api

type Doc = any

function deref(doc: Doc, node: any, seen = new Set<string>()): any {
  while (node && typeof node === 'object' && typeof node.$ref === 'string') {
    if (seen.has(node.$ref) || !node.$ref.startsWith('#/')) return {}
    seen.add(node.$ref)
    node = node.$ref
      .slice(2)
      .split('/')
      .map((s: string) => s.replace(/~1/g, '/').replace(/~0/g, '~'))
      .reduce((acc: any, k: string) => acc?.[k], doc)
  }
  return node ?? {}
}

const refName = (node: any) => (typeof node?.$ref === 'string' ? node.$ref.split('/').pop() : undefined)

function typeOf(doc: Doc, schema: any): string {
  const name = refName(schema)
  const s = deref(doc, schema)
  let t: string
  if (s.enum) t = `enum(${s.enum.map(String).join(', ')})`
  else if (s.type === 'array') t = `${typeOf(doc, s.items)}[]`
  else if (s.oneOf || s.anyOf) t = (s.oneOf ?? s.anyOf).map((x: any) => typeOf(doc, x)).join(' or ')
  else t = (s.type ?? (s.properties || s.allOf ? 'object' : 'any')) + (s.format ? ` (${s.format})` : '')
  return name && s.type === 'object' ? name : t
}

/** Merges allOf branches and returns the schema's own properties. */
function flatten(doc: Doc, schema: any, seen = new Set<string>()): any {
  const s = deref(doc, schema)
  if (!s.allOf) return s
  const merged: any = { ...s, properties: { ...s.properties }, required: [...(s.required ?? [])] }
  for (const part of s.allOf) {
    const p = flatten(doc, part, seen)
    Object.assign(merged.properties, p.properties)
    merged.required.push(...(p.required ?? []))
    merged.type ??= p.type
  }
  delete merged.allOf
  return merged
}

function schemaRows(doc: Doc, schema: any, prefix = '', depth = 0, seen = new Set<any>()): string[] {
  const s = flatten(doc, schema.type === 'array' && schema.items ? schema.items : schema)
  if (depth > 3 || seen.has(s)) return []
  seen = new Set(seen).add(s)
  const rows: string[] = []
  for (const [name, raw] of Object.entries<any>(s.properties ?? {})) {
    const p = deref(doc, raw)
    const req = s.required?.includes(name) ? 'yes' : 'no'
    rows.push(`| \`${esc(prefix + name)}\` | ${esc(typeOf(doc, raw))} | ${req} | ${esc(p.description)} |`)
    const inner = p.type === 'array' ? deref(doc, p.items) : p
    if (inner.properties || inner.allOf) rows.push(...schemaRows(doc, inner, `${prefix}${name}${p.type === 'array' ? '[]' : ''}.`, depth + 1, seen))
  }
  return rows
}

function example(doc: Doc, schema: any, depth = 0, seen = new Set<any>()): any {
  const s = flatten(doc, schema)
  if (s.example !== undefined) return s.example
  if (s.default !== undefined) return s.default
  if (s.enum) return s.enum[0]
  if (depth > 4 || seen.has(s)) return null
  seen = new Set(seen).add(s)
  if (s.oneOf || s.anyOf) return example(doc, (s.oneOf ?? s.anyOf)[0], depth + 1, seen)
  if (s.type === 'array') return [example(doc, s.items ?? {}, depth + 1, seen)]
  if (s.properties || s.type === 'object') {
    return Object.fromEntries(Object.entries<any>(s.properties ?? {}).map(([k, v]) => [k, example(doc, v, depth + 1, seen)]))
  }
  switch (s.type) {
    case 'integer': case 'number': return 0
    case 'boolean': return true
    case 'string': return s.format === 'date-time' ? '2024-01-01T00:00:00Z' : s.format === 'date' ? '2024-01-01' : 'string'
    default: return null
  }
}

const json = (v: unknown) => '```json\n' + JSON.stringify(v, null, 2) + '\n```'

function jsonContent(content: any): { type: string; schema: any } | undefined {
  if (!content) return undefined
  const type = Object.keys(content).find((t) => t.includes('json')) ?? Object.keys(content)[0]
  return type ? { type, schema: content[type]?.schema ?? {} } : undefined
}

function renderOperation(doc: Doc, method: string, route: string, op: any, shared: any[]): string {
  const m = method.toLowerCase()
  const name = op.summary ?? op.operationId ?? `${method.toUpperCase()} ${route}`
  const lines: string[] = [`### ${esc(name)}`, '']
  lines.push(
    `<div class="api-endpoint"><span class="api-method ${m}">${method.toUpperCase()}</span><code class="api-path">${esc(route)}</code>${op.deprecated ? '<span class="api-deprecated">deprecated</span>' : ''}</div>`,
    '',
  )
  if (op.description) lines.push(prose(op.description), '')

  const params = [...shared, ...(op.parameters ?? [])].map((p) => deref(doc, p))
  const query = params.filter((p) => p.in !== 'body')
  if (query.length) {
    lines.push('**Parameters**', '', '| Name | In | Type | Required | Description |', '| --- | --- | --- | --- | --- |')
    for (const p of query) lines.push(`| \`${esc(p.name)}\` | ${p.in} | ${esc(typeOf(doc, p.schema ?? p))} | ${p.required ? 'yes' : 'no'} | ${esc(p.description)} |`)
    lines.push('')
  }

  const bodyParam = params.find((p) => p.in === 'body')
  const body = op.requestBody ? jsonContent(deref(doc, op.requestBody).content) : bodyParam?.schema ? { type: 'application/json', schema: bodyParam.schema } : undefined
  if (body) {
    lines.push(`**Request body** (\`${body.type}\`)`, '')
    const rows = schemaRows(doc, body.schema)
    if (rows.length) lines.push('| Field | Type | Required | Description |', '| --- | --- | --- | --- |', ...rows, '')
  }

  // Request example as curl.
  const server = String(doc.servers?.[0]?.url ?? '').replace(/\/$/, '')
  const curl = [`curl -X ${method.toUpperCase()} "${server}${route}"`]
  if (body) curl.push(`  -H "Content-Type: ${body.type}"`, `  -d '${JSON.stringify(example(doc, body.schema))}'`)
  lines.push('::: details Example request', '```bash', curl.join(' \\\n'), '```', ':::', '')

  lines.push('**Responses**', '')
  for (const [code, raw] of Object.entries<any>(op.responses ?? {})) {
    const r = deref(doc, raw)
    lines.push(`<div class="api-response"><span class="api-status s${String(code)[0]}xx">${esc(code)}</span> ${esc(r.description)}</div>`, '')
    const c = jsonContent(r.content) ?? (r.schema ? { type: 'application/json', schema: r.schema } : undefined)
    if (c) {
      const rows = schemaRows(doc, c.schema)
      if (rows.length) lines.push('| Field | Type | Required | Description |', '| --- | --- | --- | --- |', ...rows, '')
      lines.push(json(example(doc, c.schema)), '')
    }
  }
  return lines.join('\n')
}

function buildApi(dir: string, rel: string, specs: string[]): { files: Map<string, string>; items: Item[] } {
  const files = new Map<string, string>()
  const items: Item[] = []
  const multi = specs.length > 1

  for (const specFile of specs) {
    const doc = readYaml(specFile)
    const specName = path.basename(specFile).replace(/\.ya?ml$/i, '')
    const apiDir = multi ? path.join(dir, '_api', slug(specName)) : path.join(dir, '_api')
    const apiRel = path.join(rel, '_api', multi ? slug(specName) : '')
    const title = doc.info?.title ?? titleCase(specName)

    // Group operations by first tag.
    const groups = new Map<string, string[]>()
    for (const [route, pathItem] of Object.entries<any>(doc.paths ?? {})) {
      const item = deref(doc, pathItem)
      for (const method of METHODS) {
        const op = item[method]
        if (!op) continue
        const tag = String(op.tags?.[0] ?? 'default')
        groups.set(tag, [...(groups.get(tag) ?? []), renderOperation(doc, method, route, op, item.parameters ?? [])])
      }
    }

    const tagDocs = new Map<string, string>((doc.tags ?? []).map((t: any) => [t.name, t.description]))
    const pages: Item[] = []
    for (const [tag, ops] of groups) {
      const file = slug(tag)
      files.set(
        path.join(apiDir, `${file}.md`),
        `---\ntitle: ${JSON.stringify(tag)}\n---\n${GENERATED}\n\n# ${esc(tag)}\n\n${tagDocs.get(tag) ? prose(tagDocs.get(tag)) + '\n\n' : ''}${ops.join('\n\n')}\n`,
      )
      pages.push({ text: tag, link: toLink(path.join(apiRel, file)) })
    }

    const servers = (doc.servers ?? []).map((s: any) => `- \`${esc(s.url)}\`${s.description ? ` — ${esc(s.description)}` : ''}`)
    files.set(
      path.join(apiDir, 'index.md'),
      `---\ntitle: ${JSON.stringify(title)}\n---\n${GENERATED}\n\n# ${esc(title)}\n\n` +
        (doc.info?.version ? `Version \`${esc(doc.info.version)}\`\n\n` : '') +
        (doc.info?.description ? `${prose(doc.info.description)}\n\n` : '') +
        (servers.length ? `## Servers\n\n${servers.join('\n')}\n\n` : '') +
        `## Endpoints\n\n${pages.map((p) => `- [${esc(p.text)}](${p.link})`).join('\n')}\n`,
    )
    const group: Item = { text: title, link: toLink(path.join(apiRel, 'index')).replace(/\/index$/, '/'), items: pages }
    items.push(group)
  }
  return { files, items: multi ? items : [{ text: 'Overview', link: items[0].link }, ...items[0].items!] }
}
